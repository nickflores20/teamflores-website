# Copy to .env.local for local testing. Never commit real values.

# ── Lead capture (server-side only: /api/lead) ──
FUB_API_KEY=
FUB_SYSTEM=SunnyHill-NV-Website
FUB_SYSTEM_KEY=
FUB_SOURCE=Website - Nick Flores Sr.
# Optional: reject form posts from any other origin, e.g. https://www.yourdomain.com
ALLOWED_ORIGIN=

# ── Build-time site settings (VITE_ values are public) ──
# Draft banner is ON unless this is "false". Turn off only after compliance approval.
VITE_DRAFT_BANNER=true
# Site is noindex unless this is "true". Turn on only after compliance approval.
VITE_ALLOW_INDEXING=false
# Final domain. Required before indexing is allowed.
VITE_SITE_URL=
# Sonar URLs (placeholders are used when empty)
VITE_SONAR_CHECK_PRICING_URL=
VITE_SONAR_START_APPLICATION_URL=
VITE_SONAR_PRE_APPROVAL_URL=
# Optional, hidden until set to a confirmed URL
VITE_SCHEDULING_URL=
